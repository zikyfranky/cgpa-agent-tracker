generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(cuid())
  matricNumber  String   @unique
  role          String   @default("STUDENT")
  targetCgpa    Float    @default(3.5)
  results       Result[]
  topics        Topic[]
  timetable     Timetable[]
  state         UserState?
  createdAt     DateTime @default(now())
}

model Result {
  id          String   @id @default(cuid())
  userId      String
  courseCode  String
  courseName  String?
  units       Int      @default(0)
  level       Int
  semester    String
  grade       String
  gradePoint  Int
  caScore     Float?
  examScore   Float?
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseCode, level, semester])
}

model Topic {
  level         Int      @default(300)
  semester      String   @default("Second Semester")
  id            String   @id @default(cuid())
  userId        String
  courseCode    String
  title         String
  content       String?  // The extracted text or summary
  difficulty    Int      @default(1) // 1-5 scale
  status        String   @default("UNSEEN") // UNSEEN, READING, MASTERED
  feedback      String?
  sourceFile    String?  // Path to the file in /courses/
  lastStudiedAt DateTime?
  user          User     @relation(fields: [userId], references: [id])

  @@index([courseCode])
}

model Timetable {
  id          String   @id @default(cuid())
  userId      String
  courseCode  String
  day         String   // Monday, Tuesday, etc.
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  location    String?
  user        User     @relation(fields: [userId], references: [id])
}

model UserState {
  id              String @id @default(cuid())
  userId          String @unique
  currentLevel    Int    @default(300)
  currentSemester String @default("Second Semester")
  activeTab       String @default("300")
  user            User   @relation(fields: [userId], references: [id])
}
